{
  "title": "Recipe System Overview",
  "uid": "recipe-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Targets UP", "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(up)" }] },
    { "id": 2, "type": "stat", "title": "MySQL UP (1 = OK)", "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "mysql_up" }] },
    { "id": 3, "type": "stat", "title": "Nginx active connections", "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "nginx_connections_active" }] },
    { "id": 4, "type": "stat", "title": "Running containers", "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "count(container_last_seen{name=~\"recipe-.+\"})" }] },
    { "id": 5, "type": "timeseries", "title": "Container CPU (cores)", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{name=~\"recipe-.+\"}[1m]))", "legendFormat": "{{name}}" }] },
    { "id": 6, "type": "timeseries", "title": "Container memory", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [{ "refId": "A", "expr": "sum by (name) (container_memory_working_set_bytes{name=~\"recipe-.+\"})", "legendFormat": "{{name}}" }] },
    { "id": 7, "type": "timeseries", "title": "Nginx requests per second", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "rate(nginx_http_requests_total[1m])", "legendFormat": "requests/s" }] },
    { "id": 8, "type": "timeseries", "title": "MySQL connected threads", "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "mysql_global_status_threads_connected", "legendFormat": "threads" }] },
    { "id": 9, "type": "timeseries", "title": "MySQL queries per second", "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "rate(mysql_global_status_queries[1m])", "legendFormat": "queries/s" }] }
  ]
}